{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/website/index.html" },
    { "source": "/pages/:match*", "destination": "/website/pages/:match*" },
    { "source": "/css/:match*", "destination": "/website/css/:match*" },
    { "source": "/js/:match*", "destination": "/website/js/:match*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
